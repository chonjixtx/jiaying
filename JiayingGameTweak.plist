<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Filter</key>
    <dict>
        <!-- ElleKit 不支持 Any=true。用 UIApplication 类匹配所有普通 App/游戏，
             注入器会在 UIKit App 启动时识别到这个类。 -->
        <key>Classes</key>
        <array>
            <string>UIApplication</string>
        </array>
    </dict>
</dict>
</plist>
